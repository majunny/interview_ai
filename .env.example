# OpenAI에서 새로 발급한 서버용 키를 입력합니다. 실제 키는 절대 Git에 올리지 마세요.
OPENAI_API_KEYS=sk-your-key-here
# 키가 하나뿐이라면 기존 OPENAI_API_KEY도 사용할 수 있습니다.
# OPENAI_API_KEY=sk-your-key-here

OPENAI_MODEL=gpt-6.2-sol
PORT=3000

# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱 SDK 설정
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-firebase-app-id
# FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# Vercel 프로젝트에 Blob Store를 연결하면 자동으로 생성됩니다.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token
